  {
   "type": "timeseries",
   "title": "Requests / s by status",
   "description": "Every chat request, by the HTTP status the client got. 429 = rate limited, 502 = no backend, 499 = client left before an answer.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code) (rate(llmgw_requests_total[1m]))",
     "legendFormat": "{{code}}",
     "exemplar": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Error ratio (availability SLI)",
   "description": "The availability SLO's own expression over 1 minute: 5xx answers plus streams cut by a backend, over requests that were not the client's fault (4xx).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum(rate(llmgw_requests_total{code=~\"5..\"}[1m])) or vector(0)) + (sum(rate(llmgw_stream_interrupted_total{side=\"backend\"}[1m])) or vector(0))) / sum(rate(llmgw_requests_total{code!~\"4..\"}[1m]))",
     "legendFormat": "bad share",
     "exemplar": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "axisSoftMax": 0.01
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 6,
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 8,
    "h": 8
   }
  },
  {
   "type": "timeseries",

  {
   "type": "timeseries",
   "title": "Availability burn rate",
   "description": "How many times faster than allowed the availability error budget is being spent. A page fires when both the long and the short window cross the same threshold.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:llmgw_availability:error_ratio_rate30s / 0.005",
     "legendFormat": "30s window",
     "exemplar": false,
     "range": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:llmgw_availability:error_ratio_rate150s / 0.005",
     "legendFormat": "150s window",
     "exemplar": false,
     "range": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:llmgw_availability:error_ratio_rate5m / 0.005",
     "legendFormat": "5m window",
     "exemplar": false,
     "range": true
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "slo:llmgw_availability:error_ratio_rate30m / 0.005",
     "legendFormat": "30m window",
     "exemplar": false,
     "range": true
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(14.4)",
     "legendFormat": "fast-burn page threshold",
     "exemplar": false,
     "range": true
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "vector(6)",
     "legendFormat": "slow-burn page threshold",
     "exemplar": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
